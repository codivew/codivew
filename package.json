{
  "name": "codivew",
  "version": "0.1.1",
  "private": false,
  "type": "module",
  "description": "Codivew CLI for local AI code reviews powered by Ollama",
  "license": "MIT",
  "bin": {
    "codivew": "dist/main.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "node --loader ts-node/esm src/main.ts",
    "clean": "node scripts/clean-dist.mjs",
    "generate:report-style": "tailwindcss -i ./src/reporting/report.css -o ./.report-style.tmp.css --minify && node scripts/generate-report-style.mjs",
    "predev": "npm run generate:report-style",
    "prebuild": "npm run clean && npm run generate:report-style",
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run typecheck && npm run lint && npm test",
    "pretypecheck": "npm run generate:report-style",
    "typecheck": "tsc --noEmit --incremental false",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{json,md,mjs}\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"*.{json,md,mjs}\" \"scripts/**/*.mjs\"",
    "pretest": "npm run generate:report-style",
    "test": "jest --config jest.config.mjs",
    "prepack": "npm run check && npm run build"
  },
  "dependencies": {
    "preact": "^10.29.7",
    "preact-render-to-string": "^6.7.0",
    "update-notifier": "^7.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@tailwindcss/cli": "^4.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^18.19.0",
    "@types/update-notifier": "^6.0.8",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.3",
    "jest": "^30.0.5",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.3",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.38.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}